# ----------------- Server & Database -----------------
PORT=3000
DATABASE_URL=postgresql://rajanayak@localhost:5434/ai_calling
BACKEND_URL=http://localhost:3000
INTERNAL_SECRET=change-this-internal-secret-for-agent-auth

# ----------------- LiveKit Cloud / Server -----------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxx
LIVEKIT_API_SECRET=secxxxxxxxxxxxxxxxxxxxxxxxxx
AGENT_NAME=telecom-router-pickup-agent

# ----------------- Exotel SIP Trunk & Telephony -----------------
# Created via scripts/create-outbound-trunk.ts or LiveKit Cloud dashboard
SIP_PROVIDER=exotel
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
SIP_INBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
SIP_DISPATCH_RULE_ID=SDR_xxxxxxxxxxxx
# SIP_DOMAIN: Exotel SIP termination domain (e.g. <subdomain>.pstn.exotel.com:5070 or pstn.exotel.com:5070)
SIP_DOMAIN=curoai1.pstn.exotel.com:5070
# SIP_CALLER_ID: Your allocated Exotel ExoPhone virtual number (e.g. +9109513886363 or 09513886363)
SIP_CALLER_ID=+9109513886363
# SIP_USERNAME & PASSWORD: SIP digest authentication credentials provisioned on Exotel dashboard
SIP_USERNAME=your_exotel_sip_username
SIP_PASSWORD=your_exotel_sip_password

# Optional Exotel API credentials (if integrating Exotel Call/Campaign REST APIs)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=your_exotel_subdomain

# Exotel v1 REST API credentials for recording download (Section 6 of spec)
# Used to fetch recording URLs from Exotel call-details API:
#   GET https://api.exotel.com/v1/Accounts/{EXOTEL_SID}/Calls/{CallSid}.json
# EXOTEL_SID is usually the same as EXOTEL_ACCOUNT_SID; EXOTEL_TOKEN is the API token
EXOTEL_SID=your_exotel_account_sid
EXOTEL_TOKEN=your_exotel_api_token

# Path to store downloaded call recordings (private storage — NOT publicly accessible)
# In production, replace with a private S3/GCS bucket and update recordingDownloader.ts
RECORDING_STORAGE_DIR=/var/data/recordings

# ----------------- AI Models & Speech Providers -----------------
# Sarvam AI — Indic STT (Saaras v4) and TTS (Bulbul v3, speaker: Priya)
SARVAM_API_KEY=your_sarvam_api_key

# OpenRouter — LLM provider (meta-llama/llama-3.3-70b-instruct)
OPENROUTER_API_KEY=your_openrouter_api_key
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# ----------------- Test Configuration -----------------
# Test customer phone number in E.164 format (e.g. +919876543210)
TEST_PHONE=+919876543210
TEST_CUSTOMER_NAME="Raja Nayak"
TEST_CUSTOMER_ADDRESS="Flat 402, Sunshine Heights, Koramangala 4th Block, Bengaluru, Karnataka 560034"
