# ----------------- Server & Database -----------------
PORT=3000
DATABASE_URL=postgresql://rajanayak@localhost:5434/ai_calling
BACKEND_URL=http://localhost:3000
INTERNAL_SECRET=change-this-internal-secret-for-agent-auth

# ----------------- LiveKit Cloud / Server -----------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxx
LIVEKIT_API_SECRET=secxxxxxxxxxxxxxxxxxxxxxxxxx
AGENT_NAME=telecom-router-pickup-agent

# ----------------- Exotel SIP Trunk & Telephony -----------------
# Created via scripts/create-outbound-trunk.ts or LiveKit dashboard
# Telephony SIP Outbound Trunk Settings (Twilio, Exotel, Telnyx):
SIP_PROVIDER=twilio
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
# SIP_DOMAIN: e.g. your-subdomain.pstn.twilio.com (or pstn.exotel.com:5070 / sip.telnyx.com)
SIP_DOMAIN=your-subdomain.pstn.twilio.com
# SIP_CALLER_ID: Your allocated caller phone number in E.164 format (e.g. +1XXXXXXXXXX or +91XXXXXXXXXX)
SIP_CALLER_ID=+1XXXXXXXXXX
# SIP_USERNAME & PASSWORD: SIP digest authentication credentials provisioned for the trunk
SIP_USERNAME=your_sip_username
SIP_PASSWORD=your_sip_password

# ----------------- AI Models & Speech Providers -----------------
# Sarvam AI API Key for Indic STT (Saaras) and TTS (Bulbul)
SARVAM_API_KEY=your_sarvam_api_key

# Groq API Key and Model for Ultra-low Latency Conversational LLM
GROQ_API_KEY=your_groq_api_key
# Default to llama-3.1-8b-instant on Groq
LLM_MODEL=llama-3.1-8b-instant

# ----------------- Test Configuration -----------------
# Test customer phone number in E.164 format (e.g. +919876543210)
TEST_PHONE=+919876543210
TEST_CUSTOMER_NAME="Raja Nayak"
TEST_CUSTOMER_ADDRESS="Flat 402, Sunshine Heights, Koramangala 4th Block, Bengaluru, Karnataka 560034"
